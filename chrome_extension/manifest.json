{
  "manifest_version": 3,
  "name": "Job Agent",
  "description": "Extract a job description and review an evidence-grounded tailored resume.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Job Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
