{
  "manifest_version": 3,
  "name": "Northstar Job Lens",
  "description": "Extract the current job and get a focused resume match analysis.",
  "version": "0.2.2",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Analyze this job"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
